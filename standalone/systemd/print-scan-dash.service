[Unit]
Description=print-scan: LAN dashboard on port 80
After=network-online.target cups.service
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/default/print-scan
ExecStart=/usr/bin/python3 /opt/print-scan/dashboard/server.py
User=printdash
Group=printdash
SupplementaryGroups=scanner nasread
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
